{
  "manifest_version": 3,
  "name": "Barobogi 웹 번역",
  "short_name": "Barobogi 번역",
  "description": "이 Mac의 Barobogi(Mac 기본 번역, 기기 내)로 웹 페이지 글자와 이미지 속 글자를 번역합니다.",
  "version": "__SMT_VERSION__",
  "background": { "scripts": ["background.js"], "persistent": false },
  "action": {
    "default_title": "Barobogi 웹 번역",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "activeTab", "scripting", "nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "web_accessible_resources": [
    { "resources": ["fonts/*.ttf"], "matches": ["http://*/*", "https://*/*"] }
  ],
  "browser_specific_settings": { "safari": { "strict_min_version": "17.0" } }
}
